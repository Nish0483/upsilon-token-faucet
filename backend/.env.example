# Operator (pays drip gas)
OPERATOR_PRIVATE_KEY=

# RPC
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
HOODI_RPC_URL=https://0xrpc.io/hoodi
BSC_TESTNET_RPC_URL=https://bsc-testnet-rpc.publicnode.com

# Faucets
FAUCET_SEPOLIA=
FAUCET_HOODI=
FAUCET_BSC=

# API
PORT=8787
# Comma-separated. On Vercel, include your deployment URL (same-origin /api needs no CORS).
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
ALLOW_LOCAL_IP=true
TRUST_PROXY=true
MAX_CLAIMS_PER_IP_PER_DAY=6
RATE_LIMIT_PER_MIN=10

# VPN / proxy gate (proxycheck.io)
PROXYCHECK_API_KEY=
IP_RISK_THRESHOLD=66
# FORCE_CLIENT_IP=185.220.101.1
